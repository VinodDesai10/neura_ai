    <text x="412" y="120" font-size="24" font-weight="bold" font-family="monospace" fill="#3b82f6">28.8%</text>
    <text x="412" y="146" font-size="10" fill="#64748b">BEFORE Recall</text>
    <rect x="580" y="78" width="165" height="78" rx="7" fill="#22c55e22" stroke="#22c55e" stroke-width="2"/>
    <text x="592" y="120" font-size="24" font-weight="bold" font-family="monospace" fill="#22c55e">51.9%</text>
    <text x="592" y="146" font-size="10" fill="#64748b">AFTER Recall</text>
    <rect x="760" y="78" width="165" height="78" rx="7" fill="#3b82f622" stroke="#3b82f6" stroke-width="2"/>
    <text x="772" y="120" font-size="24" font-weight="bold" font-family="monospace" fill="#3b82f6">15.2%</text>
    <text x="772" y="146" font-size="10" fill="#64748b">BEFORE F1</text>
    <rect x="940" y="78" width="165" height="78" rx="7" fill="#22c55e22" stroke="#22c55e" stroke-width="2"/>
    <text x="952" y="120" font-size="24" font-weight="bold" font-family="monospace" fill="#22c55e">25.5%</text>
    <text x="952" y="146" font-size="10" fill="#64748b">AFTER F1</text>
    <rect x="1120" y="78" width="165" height="78" rx="7" fill="#f59e0b22" stroke="#f59e0b" stroke-width="2"/>
    <text x="1132" y="120" font-size="24" font-weight="bold" font-family="monospace" fill="#f59e0b">23.1%</text>
    <text x="1132" y="146" font-size="10" fill="#64748b">TP: ${BEFORE_AGG.totalTP}→${afterAgg.totalTP} (+${afterAgg.totalTP-BEFORE_AGG.totalTP})</text>

