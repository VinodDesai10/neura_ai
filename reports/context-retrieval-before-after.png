  <text x="40" y="38" font-size="20" font-weight="bold" fill="#e2e8f0">Neura AI — Retrieval Improvement: Before vs After</text>
  <text x="40" y="60" font-size="12" fill="#64748b">40 queries · 104 expected · Same ground truth · 3 fixes applied</text>

  
    <rect x="40" y="78" width="165" height="78" rx="7" fill="#3b82f622" stroke="#3b82f6" stroke-width="2"/>
    <text x="52" y="120" font-size="24" font-weight="bold" font-family="monospace" fill="#3b82f6">10.3%</text>
    <text x="52" y="146" font-size="10" fill="#64748b">BEFORE Precision</text>
    <rect x="220" y="78" width="165" height="78" rx="7" fill="#22c55e22" stroke="#22c55e" stroke-width="2"/>
    <text x="232" y="120" font-size="24" font-weight="bold" font-family="monospace" fill="#22c55e">16.9%</text>
    <text x="232" y="146" font-size="10" fill="#64748b">AFTER Precision</text>
