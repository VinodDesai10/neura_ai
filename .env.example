OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MONGODB_URI=
MONGODB_DATABASE=neura_ai
MONGODB_RAW_EVENTS_COLLECTION=raw_events
POSTGRES_URL=
POSTGRES_SSL=require
REDIS_URL=
REDIS_WORKING_MEMORY_PREFIX=neura:working-memory
REDIS_WORKING_MEMORY_MIN_TTL_SECONDS=900
REDIS_WORKING_MEMORY_BASE_TTL_SECONDS=3600
REDIS_WORKING_MEMORY_MAX_TTL_SECONDS=604800
REDIS_RUNTIME_PREFIX=neura
REDIS_EMBEDDING_TTL_SECONDS=604800
REDIS_EMBEDDING_SHORT_TTL_SECONDS=21600
REDIS_EMBEDDING_MEMORY_TTL_SECONDS=2592000
REDIS_RETRIEVAL_MIN_TTL_SECONDS=300
REDIS_RETRIEVAL_MAX_TTL_SECONDS=7200
REDIS_RECENT_TURNS_TTL_SECONDS=604800
REDIS_SESSION_STATE_TTL_SECONDS=86400
REDIS_MEMORY_USAGE_TTL_SECONDS=2592000
CHAT_RATE_LIMIT_MAX_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=neura_vector_memories
QDRANT_DISTANCE=Cosine
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Prometheus metrics ────────────────────────────────────────────────────────
# Optional Bearer token required to scrape GET /metrics.
# Leave empty or unset to allow unauthenticated scraping (safe on private networks).
METRICS_TOKEN=

# ── Hybrid retrieval pipeline ──────────────────────────────────────────────────
# Maximum number of memories returned by each findRelevant call.
RETRIEVAL_TOP_K=8

# Weights for the hybrid score (must not necessarily sum to 1;
# they are applied independently and the total is clamped to [0, 1]).
RETRIEVAL_VECTOR_WEIGHT=0.5
RETRIEVAL_LEXICAL_WEIGHT=0.2
RETRIEVAL_IMPORTANCE_WEIGHT=0.2
RETRIEVAL_RECENCY_WEIGHT=0.1

# Recency decay half-life in hours.
# Score halves every N hours; older memories are down-weighted smoothly.
RETRIEVAL_RECENCY_HALF_LIFE_HOURS=72

# Cosine similarity threshold for near-duplicate suppression (0–1).
# Candidates whose embedding similarity to an existing memory exceeds this
# value are treated as duplicates and skipped at insertion time.
RETRIEVAL_DEDUP_THRESHOLD=0.92

# Generate a compact session-summary memory after every N assistant turns.
MEMORY_SUMMARY_EVERY_N_TURNS=20

# ── Topical relevance penalty (feature flag, off by default) ──────────────────
# Set to "true" to activate. When enabled, memories whose max(vectorScore,
# normLexicalScore) falls below the thresholds below are strongly down-ranked,
# preventing high-importance but topically unrelated memories from polluting
# the LLM context window.
RETRIEVAL_TOPICAL_PENALTY_ENABLED=false

# Relevance below this threshold → apply RETRIEVAL_TOPICAL_PENALTY_LOW_FACTOR.
RETRIEVAL_TOPICAL_PENALTY_LOW_THRESHOLD=0.10

# Relevance below this threshold (but ≥ LOW_THRESHOLD) → apply MEDIUM_FACTOR.
RETRIEVAL_TOPICAL_PENALTY_HIGH_THRESHOLD=0.25

# Multiplier for very low relevance memories  (0.30 = 70% penalty).
RETRIEVAL_TOPICAL_PENALTY_LOW_FACTOR=0.30

# Multiplier for moderately low relevance memories (0.60 = 40% penalty).
RETRIEVAL_TOPICAL_PENALTY_MEDIUM_FACTOR=0.60

# ── Memory queue reliability ───────────────────────────────────────────────────
# Maximum number of attempts per job before it is moved to the dead-letter queue.
QUEUE_MAX_ATTEMPTS=5

# Base delay in milliseconds for exponential backoff between retries.
# Attempt delays (before jitter): 1s, 2s, 4s, 8s, 16s
QUEUE_BACKOFF_BASE_MS=1000

# Maximum backoff delay in milliseconds (caps the exponential growth).
QUEUE_BACKOFF_MAX_MS=30000

# Dead-letter queue record TTL in seconds. Default = 7 days.
QUEUE_DLQ_TTL_SECONDS=604800
