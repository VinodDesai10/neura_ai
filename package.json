{
  "name": "neura-ai",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @neura/web run dev",
    "dev:api": "npm --workspace @neura/api run dev",
    "worker:memory": "npm --workspace @neura/api run worker:memory",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test:retrieval": "npm --workspace @neura/api run test:retrieval",
    "test": "npm run test --workspaces --if-present",
    "confusion-matrix": "node tools/confusion-matrix.js",
    "visual-report": "node tools/confusion-matrix.js && node tools/generate-visual-report.js",
    "seed-context-evaluation": "node tools/seed-context-evaluation-data.js",
    "evaluate-context-retrieval": "node tools/evaluate-context-retrieval.js"
  }
}
