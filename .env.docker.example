OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Vercel AI Gateway (takes precedence over OPENAI_* when configured).
# Gateway models use provider/model slugs, for example: openai/gpt-5.4
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=inclusionai/ling-3.0-flash-fin
AI_GATEWAY_FALLBACK_MODEL=inclusionai/ling-3.0-flash
AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=neura_ai
MONGODB_RAW_EVENTS_COLLECTION=raw_events

POSTGRES_URL=postgres://postgres:postgres@localhost:55432/neura_ai
POSTGRES_SSL=disable

REDIS_URL=redis://localhost:6379
REDIS_WORKING_MEMORY_PREFIX=neura:working-memory

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=neura_vector_memories
QDRANT_DISTANCE=Cosine

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
